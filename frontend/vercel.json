{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agentguard-production-4534.up.railway.app/api/:path*"
    },
    {
      "source": "/ws",
      "destination": "https://agentguard-production-4534.up.railway.app/ws"
    }
  ]
}